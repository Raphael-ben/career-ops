{
  "manifest_version": 3,
  "name": "Career-ops Workday Filler",
  "version": "2.0.0",
  "description": "Fill Workday application steps from a career-ops apply.json package",
  "permissions": ["sidePanel", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "Workday Filler"
  }
}
